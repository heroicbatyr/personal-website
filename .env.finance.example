STOCK_API_KEY=replace-with-your-alpha-vantage-api-key
# Optional comma-separated pool. It is merged with and deduplicates STOCK_API_KEY.
STOCK_API_KEYS=
# Skip a provider key for 15 minutes after a provider rate-limit response.
STOCK_PROVIDER_RATE_LIMIT_COOLDOWN=PT24H
STOCK_REFRESH_TICKERS=NVDA,AAPL,MSFT,JPM
# Weekdays at 22:30 UTC, after the US market has closed.
STOCK_REFRESH_CRON=0 30 22 * * MON-FRI
FINANCE_ALLOWED_ORIGINS=https://batyrbek.com,https://www.batyrbek.com,http://localhost:4321,http://127.0.0.1:4321
FINANCE_CACHE_DIR=/app/data/cache
# Optional Vercel Blob mirror. Use the same secret in Vercel and this file.
FINANCE_BACKUP_URL=
FINANCE_BACKUP_SECRET=
