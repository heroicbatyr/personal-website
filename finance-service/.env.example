FMP_API_KEY=replace-with-your-fmp-api-key
# Optional override; leave unset to use FMP production.
FMP_API_BASE_URL=https://financialmodelingprep.com
STOCK_REFRESH_TICKERS=NVDA,AAPL,MSFT,JPM
# Weekdays at 22:30 UTC, after the US market has closed.
STOCK_REFRESH_CRON=0 30 22 * * MON-FRI
FINANCE_ALLOWED_ORIGINS=https://batyrbek.com,https://www.batyrbek.com,http://localhost:4321,http://127.0.0.1:4321
FINANCE_CACHE_DIR=/app/data/cache
FINANCE_BACKUP_URL=
FINANCE_BACKUP_SECRET=
