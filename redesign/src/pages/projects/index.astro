---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';
---
<BaseLayout title="Projects — Batyrbek Bolatbekuly">
  <Header active="Projects" />
  <main class="page-shell projects-page">
    <header class="page-intro"><p class="eyebrow section-label">Selected work</p><h1>Things I’ve built,<br />and why.</h1><p>Projects are where I turn an idea, an operational problem, or a question into something more useful.</p></header>
    <div class="project-list full-list">
      {projects.map((project) => (
        <a class={`project-row ${project.accent}`} href={`/projects/${project.slug}`}>
          <div><p class="project-type">{project.type}</p><h2>{project.title}</h2><p class="project-description">{project.description}</p><div class="tag-list">{project.tags.map(tag => <span>{tag}</span>)}</div></div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
