---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import stocks from '../../../finance-service/src/main/resources/fmp-supported-tickers.json';

const popular = stocks.filter(stock => stock.popular).slice(0, 12);
const sectors = [...new Set(stocks.map(stock => stock.sector))];
---
<BaseLayout title="Market Atlas — Batyrbek Bolatbekuly" description="Research a curated universe of publicly traded companies.">
  <Header active="Finance" />
  <main class="atlas-page page-shell" data-finance-landing data-stocks={JSON.stringify(stocks)}>
    <header class="atlas-intro">
      <p class="eyebrow section-label">Stock research dashboard</p>
      <h1>Market Atlas.</h1>
      <p>Research a curated universe of publicly traded companies through a lightweight Java-powered dashboard.</p>
    </header>

    <section class="atlas-search" aria-labelledby="search-heading">
      <div class="atlas-search-heading">
        <div><p class="eyebrow">Company research</p><h2 id="search-heading">Where do you want to look?</h2></div>
        <a class="button button-dark" href="/finance/compare">Compare companies</a>
      </div>
      <form data-catalog-form>
        <label for="company-search">Search ticker or company</label>
        <div class="search-control">
          <input id="company-search" data-catalog-input autocomplete="off" placeholder="NVIDIA, NVDA, JPMorgan…" aria-controls="catalog-results" aria-autocomplete="list" />
          <button type="submit" aria-label="Open company">→</button>
        </div>
        <div class="catalog-results" id="catalog-results" data-catalog-results role="listbox" hidden></div>
        <p class="catalog-status" data-catalog-status aria-live="polite">53 confirmed companies available.</p>
      </form>
    </section>

    <section class="atlas-section" aria-labelledby="popular-heading">
      <div class="section-heading"><div><p class="eyebrow section-label">Popular companies</p><h2 id="popular-heading">Start with the names that move markets.</h2></div></div>
      <div class="company-grid">
        {popular.map(stock =>
          <a href={`/finance/${stock.symbol}`}>
            <span>{stock.symbol}</span><strong>{stock.name}</strong><small>{stock.sector}</small><i aria-hidden="true">↗</i>
          </a>)}
      </div>
    </section>

    <section class="atlas-section sector-section" aria-labelledby="sector-heading">
      <p class="eyebrow section-label">Explore by sector</p>
      <h2 id="sector-heading">A useful cross-section of the market.</h2>
      <div class="sector-pills">
        {sectors.map(sector => <button type="button" data-sector={sector}>{sector}</button>)}
      </div>
      <div class="sector-results" data-sector-results hidden></div>
    </section>

    <section class="atlas-section recent-section" data-recent-section hidden aria-labelledby="recent-heading">
      <p class="eyebrow section-label">Recently viewed</p>
      <h2 id="recent-heading">Continue your research.</h2>
      <div class="recent-list" data-recent-list></div>
    </section>

    <footer class="atlas-note">
      <span>FMP-backed end-of-day market data · 24-hour cache</span>
      <span>Educational purposes only — not investment advice.</span>
    </footer>
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../scripts/finance-landing.ts';
</script>

<style>
  .atlas-page { padding-top:clamp(4rem,8vw,8rem); padding-bottom:7rem; }
  .atlas-intro { display:grid; grid-template-columns:1.35fr .65fr; column-gap:4rem; align-items:end; margin-bottom:clamp(4rem,8vw,7rem); }
  .atlas-intro .eyebrow { grid-column:1/-1; }
  .atlas-intro h1 { margin:0; font-size:clamp(4.2rem,9vw,8.5rem); line-height:.86; letter-spacing:-.065em; font-weight:500; }
  .atlas-intro > p:last-child { max-width:31rem; margin:0 0 .5rem; color:var(--muted); }
  .atlas-search { position:relative; border:1px solid var(--line); background:color-mix(in srgb,var(--panel) 48%,transparent); padding:clamp(1.25rem,3vw,2.5rem); }
  .atlas-search-heading { display:flex; justify-content:space-between; align-items:start; gap:2rem; }
  .atlas-search h2,.atlas-section h2 { margin:0; font-size:clamp(2rem,4vw,3.8rem); line-height:1; font-weight:500; letter-spacing:-.045em; }
  .atlas-search form { position:relative; max-width:60rem; margin-top:3rem; }
  .atlas-search label { display:block; margin-bottom:.55rem; color:var(--muted); font:.65rem var(--mono); letter-spacing:.06em; text-transform:uppercase; }
  .search-control { display:flex; border-bottom:1px solid var(--ink); }
  .search-control input { width:100%; min-width:0; border:0; outline:0; padding:.85rem 0; background:transparent; color:var(--ink); font:500 clamp(1.4rem,3.5vw,2.6rem)/1 var(--sans); }
  .search-control input::placeholder { color:color-mix(in srgb,var(--muted) 60%,transparent); }
  .search-control button { width:4rem; border:0; background:transparent; color:var(--ink); font-size:1.8rem; cursor:pointer; }
  .catalog-results { position:absolute; z-index:5; top:100%; left:0; right:0; border:1px solid var(--line); border-top:0; background:var(--paper); box-shadow:0 18px 45px color-mix(in srgb,var(--ink) 10%,transparent); }
  .catalog-results a { display:grid; grid-template-columns:5rem 1fr auto; gap:1rem; padding:.85rem 1rem; color:var(--ink); text-decoration:none; border-top:1px solid var(--line); }
  .catalog-results a:first-child { border-top:0; }
  .catalog-results a:hover,.catalog-results a:focus-visible { background:var(--panel); outline:0; }
  .catalog-results b { font:500 .82rem var(--mono); }
  .catalog-results span { font-size:.86rem; }
  .catalog-results small { color:var(--muted); }
  .catalog-status { margin:.75rem 0 0; color:var(--muted); font:.68rem var(--mono); }
  .catalog-status[data-kind='error'] { color:#9a433d; }
  .atlas-section { padding-top:6rem; margin-top:6rem; border-top:1px solid var(--line); }
  .section-heading { display:flex; justify-content:space-between; align-items:end; margin-bottom:2.5rem; }
  .company-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .company-grid a { position:relative; min-height:155px; display:flex; flex-direction:column; padding:1.25rem; border-right:1px solid var(--line); border-bottom:1px solid var(--line); color:var(--ink); text-decoration:none; transition:background .2s; }
  .company-grid a:hover,.company-grid a:focus-visible { background:var(--panel); outline:0; }
  .company-grid span { color:var(--ochre); font:.7rem var(--mono); }
  .company-grid strong { margin-top:.65rem; max-width:16rem; font-size:1.15rem; font-weight:500; }
  .company-grid small { margin-top:auto; color:var(--muted); font:.62rem var(--mono); text-transform:uppercase; }
  .company-grid i { position:absolute; top:1rem; right:1rem; font-style:normal; color:var(--muted); }
  .sector-section h2,.recent-section h2 { max-width:52rem; }
  .sector-pills { display:flex; flex-wrap:wrap; gap:.6rem; margin-top:2.5rem; }
  .sector-pills button { border:1px solid var(--line); padding:.65rem .9rem; background:transparent; color:var(--ink); font:.7rem var(--mono); cursor:pointer; }
  .sector-pills button:hover,.sector-pills button:focus-visible,.sector-pills button[aria-pressed='true'] { border-color:var(--ink); background:var(--ink); color:var(--paper); outline:0; }
  .sector-results,.recent-list { display:flex; flex-wrap:wrap; gap:.65rem; margin-top:1.5rem; }
  .sector-results a,.recent-list a { border-bottom:1px solid var(--line); padding:.5rem 0; color:var(--ink); text-decoration:none; font:.76rem var(--mono); }
  .sector-results a:hover,.recent-list a:hover { color:var(--ochre); }
  .atlas-note { display:flex; justify-content:space-between; gap:2rem; margin-top:7rem; padding-top:1rem; border-top:1px solid var(--line); color:var(--muted); font:.65rem var(--mono); }
  :global(.catalog-result) { display:grid; grid-template-columns:5rem 1fr auto; gap:1rem; align-items:center; padding:1rem; color:var(--ink); text-decoration:none; border-top:1px solid var(--line); }
  :global(.catalog-result:first-child) { border-top:0; }
  :global(.catalog-result:hover),:global(.catalog-result:focus-visible) { background:var(--panel); outline:0; }
  :global(.catalog-result b) { color:var(--ochre); font:500 .8rem var(--mono); }
  :global(.catalog-result span) { display:flex; flex-direction:column; gap:.2rem; }
  :global(.catalog-result strong) { font-size:.9rem; font-weight:500; }
  :global(.catalog-result small) { color:var(--muted); font:.62rem var(--mono); text-transform:uppercase; }
  :global(.catalog-result i) { color:var(--muted); font-style:normal; }
  .sector-results { display:grid; grid-template-columns:repeat(3,1fr); gap:0; margin-top:1.5rem; border-top:1px solid var(--line); border-left:1px solid var(--line); }
  :global(.sector-card) { position:relative; min-height:145px; display:flex; flex-direction:column; padding:1rem; border-right:1px solid var(--line); border-bottom:1px solid var(--line); color:var(--ink); text-decoration:none; }
  :global(.sector-card:hover),:global(.sector-card:focus-visible) { background:var(--panel); outline:0; }
  :global(.sector-card b) { color:var(--ochre); font:.7rem var(--mono); }
  :global(.sector-card strong) { margin-top:.6rem; padding-right:1.5rem; font-weight:500; }
  :global(.sector-card small) { margin-top:auto; color:var(--muted); font:.6rem var(--mono); text-transform:uppercase; }
  :global(.sector-card i) { position:absolute; top:1rem; right:1rem; color:var(--muted); font-style:normal; }
  .recent-list { display:grid; grid-template-columns:repeat(3,1fr); gap:.65rem; }
  :global(.recent-card) { display:grid; grid-template-columns:4rem 1fr auto; gap:.6rem; align-items:center; border:1px solid var(--line); padding:.8rem; color:var(--ink); text-decoration:none; }
  :global(.recent-card:hover),:global(.recent-card:focus-visible) { border-color:var(--ink); outline:0; }
  :global(.recent-card b) { color:var(--ochre); font:.7rem var(--mono); }
  :global(.recent-card span) { font-size:.78rem; }
  :global(.recent-card i) { color:var(--muted); font-style:normal; }
  @media (max-width:800px) {
    .atlas-intro { grid-template-columns:1fr; row-gap:2rem; }
    .company-grid,.sector-results,.recent-list { grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width:600px) {
    .atlas-page { padding-top:3.5rem; padding-bottom:5rem; }
    .atlas-intro { margin-bottom:4rem; }
    .atlas-intro h1 { font-size:clamp(3.8rem,18vw,5.5rem); }
    .atlas-search-heading { display:block; }
    .atlas-search-heading .button { margin-top:1.5rem; }
    .company-grid,.sector-results,.recent-list { grid-template-columns:1fr; }
    .company-grid a { min-height:125px; }
    .catalog-results a { grid-template-columns:4rem 1fr; }
    .catalog-results small { display:none; }
    .atlas-note { display:block; }
    .atlas-note span { display:block; }
    .atlas-note span + span { margin-top:.6rem; }
  }
</style>
