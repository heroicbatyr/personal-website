---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import stocks from '../../../../finance-service/src/main/resources/fmp-supported-tickers.json';

const apiBase = import.meta.env.PUBLIC_FINANCE_API_BASE_URL || 'https://server.batyrbek.com';
---
<BaseLayout title="Compare Companies — Market Atlas" description="Compare the market performance and key metrics of two public companies.">
  <Header active="Finance" />
  <main class="compare-page page-shell" data-compare-app data-api-base={apiBase}>
    <header class="compare-intro">
      <a href="/finance">← Market Atlas</a>
      <p class="eyebrow section-label">Company comparison</p>
      <h1>Two companies.<br />One scale.</h1>
      <p>Compare relative performance instead of misleading raw share prices. Both histories begin at an index value of 100.</p>
    </header>

    <section class="compare-controls" aria-labelledby="compare-heading">
      <div><p class="eyebrow">Select companies</p><h2 id="compare-heading">Build a comparison.</h2></div>
      <form data-compare-form>
        <label>First company<select data-first-symbol>{stocks.map(stock => <option value={stock.symbol} selected={stock.symbol === 'NVDA'}>{stock.symbol} · {stock.name}</option>)}</select></label>
        <span>vs</span>
        <label>Second company<select data-second-symbol>{stocks.map(stock => <option value={stock.symbol} selected={stock.symbol === 'AMD'}>{stock.symbol} · {stock.name}</option>)}</select></label>
        <button class="button button-dark" type="submit">Compare</button>
      </form>
      <p data-compare-status role="status" aria-live="polite">Loading comparison…</p>
    </section>

    <section class="compare-chart-panel" data-compare-results hidden>
      <div class="compare-heading">
        <div><p class="eyebrow">Normalized performance</p><h2 data-compare-title>NVDA vs AMD</h2></div>
        <div class="compare-legend"><span><i></i><b data-first-label>NVDA</b> <em data-first-return>—</em></span><span><i></i><b data-second-label>AMD</b> <em data-second-return>—</em></span></div>
      </div>
      <div class="compare-ranges" role="group" aria-label="Comparison range">
        {['1M', '6M', '1Y', '5Y'].map(range => <button type="button" data-compare-range={range.toLowerCase()} aria-pressed={range === '1Y'}>{range}</button>)}
      </div>
      <div class="compare-chart"><svg data-compare-chart role="img" aria-label="Normalized company performance comparison"></svg><p data-chart-message></p></div>
    </section>

    <section class="comparison-table" data-comparison-table hidden aria-labelledby="metrics-heading">
      <p class="eyebrow section-label">Side by side</p>
      <h2 id="metrics-heading">Key metrics.</h2>
      <div class="table-wrap"><table>
        <thead><tr><th>Metric</th><th data-table-first>NVDA</th><th data-table-second>AMD</th></tr></thead>
        <tbody>
          <tr><td>Market cap</td><td data-first-market-cap>—</td><td data-second-market-cap>—</td></tr>
          <tr><td>P / E ratio</td><td data-first-pe>—</td><td data-second-pe>—</td></tr>
          <tr><td>EPS</td><td data-first-eps>—</td><td data-second-eps>—</td></tr>
          <tr><td>52-week low</td><td data-first-low>—</td><td data-second-low>—</td></tr>
          <tr><td>52-week high</td><td data-first-high>—</td><td data-second-high>—</td></tr>
        </tbody>
      </table></div>
    </section>

    <footer class="compare-note"><span>Relative performance is rebased to 100 for the selected period.</span><span>Educational purposes only — not investment advice.</span></footer>
  </main>
  <Footer />
</BaseLayout>
<script>import '../../scripts/finance-compare.ts';</script>

<style>
  .compare-page { padding-top:clamp(4rem,8vw,8rem); padding-bottom:7rem; }
  .compare-intro { display:grid; grid-template-columns:1.35fr .65fr; gap:1rem 4rem; align-items:end; margin-bottom:clamp(4rem,8vw,7rem); }
  .compare-intro > a,.compare-intro .eyebrow { grid-column:1/-1; }
  .compare-intro > a { width:max-content; color:var(--muted); font:.68rem var(--mono); text-decoration:none; text-transform:uppercase; }
  .compare-intro > a:hover { color:var(--ochre); }
  .compare-intro h1 { margin:0; font-size:clamp(3.8rem,7vw,7rem); line-height:.9; letter-spacing:-.06em; font-weight:500; }
  .compare-intro > p:last-child { max-width:31rem; margin:0 0 .5rem; color:var(--muted); }
  .compare-controls,.compare-chart-panel { border:1px solid var(--line); padding:clamp(1.25rem,3vw,2.5rem); background:color-mix(in srgb,var(--panel) 48%,transparent); }
  .compare-controls h2,.compare-chart-panel h2,.comparison-table h2 { margin:0; font-size:clamp(2rem,4vw,3.6rem); line-height:1; letter-spacing:-.045em; font-weight:500; }
  .compare-controls form { display:grid; grid-template-columns:1fr auto 1fr auto; gap:1rem; align-items:end; margin-top:2.5rem; }
  .compare-controls label { color:var(--muted); font:.64rem var(--mono); text-transform:uppercase; }
  .compare-controls select { display:block; width:100%; margin-top:.5rem; border:0; border-bottom:1px solid var(--ink); border-radius:0; padding:.75rem 0; background:transparent; color:var(--ink); font:500 1rem var(--mono); }
  .compare-controls form > span { padding-bottom:.85rem; color:var(--muted); font:.68rem var(--mono); text-transform:uppercase; }
  .compare-controls [data-compare-status] { min-height:1.2rem; margin:1.2rem 0 0; color:var(--muted); font:.68rem var(--mono); }
  .compare-controls [data-compare-status][data-kind='error'] { color:#9a433d; }
  .compare-chart-panel { border-top:0; }
  .compare-heading { display:flex; justify-content:space-between; gap:2rem; align-items:end; }
  .compare-legend { display:flex; gap:1.25rem; flex-wrap:wrap; font:.7rem var(--mono); }
  .compare-legend span { display:flex; align-items:center; gap:.4rem; }
  .compare-legend i { width:1.5rem; height:2px; background:var(--ochre); }
  .compare-legend span:nth-child(2) i { background:#55774f; }
  .compare-legend em { color:var(--muted); font-style:normal; }
  .compare-ranges { display:flex; width:max-content; margin:2rem 0 1rem auto; border:1px solid var(--line); }
  .compare-ranges button { border:0; border-right:1px solid var(--line); padding:.55rem .9rem; background:transparent; color:var(--muted); font:.68rem var(--mono); cursor:pointer; }
  .compare-ranges button:last-child { border-right:0; }
  .compare-ranges button[aria-pressed='true'] { background:var(--ink); color:var(--paper); }
  .compare-chart { position:relative; height:clamp(260px,38vw,450px); }
  .compare-chart svg { width:100%; height:100%; display:block; }
  .compare-chart > p { position:absolute; inset:0; display:grid; place-items:center; color:var(--muted); pointer-events:none; }
  :global(.compare-grid) { stroke:var(--line); stroke-width:1; vector-effect:non-scaling-stroke; }
  :global(.compare-axis) { fill:var(--muted); font:10px var(--mono); }
  :global(.compare-line-first),:global(.compare-line-second) { fill:none; stroke-width:2; vector-effect:non-scaling-stroke; }
  :global(.compare-line-first) { stroke:var(--ochre); }
  :global(.compare-line-second) { stroke:#55774f; }
  .comparison-table { padding-top:6rem; margin-top:6rem; border-top:1px solid var(--line); }
  .table-wrap { overflow-x:auto; margin-top:2.5rem; }
  table { width:100%; border-collapse:collapse; min-width:520px; }
  th,td { padding:1rem; border:1px solid var(--line); text-align:right; font:500 .8rem var(--mono); }
  th:first-child,td:first-child { text-align:left; color:var(--muted); text-transform:uppercase; }
  th { background:var(--panel); }
  .compare-note { display:flex; justify-content:space-between; gap:2rem; margin-top:6rem; padding-top:1rem; border-top:1px solid var(--line); color:var(--muted); font:.65rem var(--mono); }
  [hidden] { display:none !important; }
  @media (max-width:800px) { .compare-intro { grid-template-columns:1fr; } .compare-controls form { grid-template-columns:1fr 1fr; } .compare-controls form > span { display:none; } }
  @media (max-width:600px) { .compare-page { padding-top:3.5rem; } .compare-controls form { grid-template-columns:1fr; } .compare-heading { display:block; } .compare-legend { margin-top:1.5rem; } .compare-ranges { width:100%; } .compare-ranges button { flex:1; } .compare-note { display:block; } .compare-note span { display:block; } .compare-note span + span { margin-top:.6rem; } }
</style>
